# Живой синк с Google (см. README, «Живой синк с Google»).
# Работает только там, где есть постоянный диск: на Vercel писать некуда.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Общий секрет крон-роутов: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Загрузка файлов кнопкой с дашборда (см. README, «Загрузка файлов с дашборда»).
# Нужен только там, где файловая система только для чтения (Vercel): этим
# токеном дашборд коммитит выгрузки в fixtures/. Права: Contents: Read and write.
RADAR_GITHUB_TOKEN=
# Владельца, репозиторий и ветку Vercel подставляет сам — задавайте, только
# если нужно писать не в тот репозиторий, из которого собран деплой.
# RADAR_GITHUB_REPO=владелец/репозиторий
# RADAR_GITHUB_BRANCH=main

# Общий код, который панель загрузки спросит один раз. Пусто — загрузка
# открыта всем, у кого есть ссылка на дашборд.
RADAR_UPLOAD_TOKEN=

# Что использовать хранилищем: sqlite | snapshot. Пусто — выбирается само.
# RADAR_STORAGE=
